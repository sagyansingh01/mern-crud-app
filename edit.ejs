<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Student</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <h1>✏ Edit Student</h1>

    <% if (typeof error !== "undefined" && error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <!-- Edit Student Form -->
    <form action="/update/<%= student._id %>" method="POST" class="form">
      <input type="text" name="name" value="<%= student.name %>" required>
      <input type="number" name="age" value="<%= student.age %>" required>
      <input type="date" name="dob" value="<%= student.dob.toISOString().split('T')[0] %>" required>
      <input type="text" name="course" value="<%= Array.isArray(student.course) ? student.course.join(', ') : student.course %>" required>
      <input type="text" name="roll_no" value="<%= student.roll_no %>" required>
      <button type="submit">💾 Update Student</button>
    </form>

    <a href="/" class="btn-back">⬅ Back</a>
  </div>
</body>
</html>
